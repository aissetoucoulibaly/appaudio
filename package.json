{
  "name": "appaudio",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.21",
    "expo-audio": "~58.0.10",
    "expo-constants": "~58.0.14",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.28",
    "expo-speech": "~58.0.3",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "export:web": "expo export --platform web",
    "export:ios": "expo export --platform ios",
    "test:e2e": "playwright test",
    "server": "node --use-env-proxy --env-file=.env.server.local server/service.mjs",
    "test:server": "node server/service.test.mjs",
    "server:purge": "node --env-file=.env.server.local server/purge.mjs",
    "server:setup": "node server/setup.mjs"
  },
  "private": true
}
